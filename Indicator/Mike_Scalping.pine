//@version=6
indicator("NASDAQ HEDGE FUND SCALPING V1", shorttitle="Mike_Scalping", overlay=true, max_labels_count=500)

// ╔══════════════════════════════════════════════╗
// ║               CONFIGURACIÓN                  ║
// ╚══════════════════════════════════════════════╝

// grupo_ema    = "── MEDIAS MÓVILES (EMA) ──"
// emaFastLen = input.int(9,  "EMA Rápida", group=grupo_ema)
// emaMidLen  = input.int(21, "EMA Media",  group=grupo_ema)
// emaSlowLen = input.int(50, "EMA Lenta", group=grupo_ema)

// grupo_filtros = "── FILTROS DE MERCADO ──"
// volMultiplier = input.float(2.0,  "Volumen Institucional (x SMA)",   group=grupo_filtros)
// rsiLen        = input.int(14,     "Longitud RSI",                    group=grupo_filtros)
// useSession    = input.bool(true,  "Filtro Sesión (9:30–16:00 NY)",   group=grupo_filtros)
// useATR        = input.bool(true,  "Filtro ATR Volatilidad",          group=grupo_filtros)
// useHTF        = input.bool(true,  "Confirmación Temporalidad HTF",   group=grupo_filtros)
// htfTF         = input.timeframe("15", "Temporalidad HTF",              group=grupo_filtros)

// grupo_vix    = "── VIX (VOLATILIDAD) ──"
// vixBullThr = input.float(20.0, "Umbral Alcista (Por debajo de)", group=grupo_vix)
// vixBearThr = input.float(22.0, "Umbral Bajista (Por encima de)",  group=grupo_vix)

// grupo_riesgo = "── GESTIÓN DE RIESGO ──"
// slMult   = input.float(1.5, "Multiplicador SL (ATR)",   group=grupo_riesgo)
// tpMult   = input.float(3.0, "Multiplicador TP (ATR)",   group=grupo_riesgo)
// maxDaily = input.int(30,     "Máximo de Señales / Día",  group=grupo_riesgo)

emaFastLen = 9
emaMidLen  = 21
emaSlowLen = 50

volMultiplier = 2.0
rsiLen        = 14
useSession    = true
useATR        = true
useHTF        = true
htfTF         = "15"

vixBullThr = 20.0
vixBearThr = 22.0

slMult   = 1.0
tpMult   = 2.0
maxDaily = 100

// ╔══════════════════════════════════════════════╗
// ║             DATOS DE MERCADO                 ║
// ╚══════════════════════════════════════════════╝

// VIX en Diario para evitar valores 'na' en temporalidades pequeñas de Scalping
vix = request.security("CBOE:VIX", "D", close)


// ╔══════════════════════════════════════════════╗
// ║             TENDENCIA EMA                    ║
// ╚══════════════════════════════════════════════╝

emaFast   = ta.ema(close, emaFastLen)
emaMid    = ta.ema(close, emaMidLen)
emaSlow   = ta.ema(close, emaSlowLen)
trendBull = emaFast > emaMid and emaMid > emaSlow
trendBear = emaFast < emaMid and emaMid < emaSlow


// ╔══════════════════════════════════════════════╗
// ║             MOMENTUM                         ║
// ╚══════════════════════════════════════════════╝

rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
momentumBull = rsi > 55 and macdLine > macdSignal
momentumBear = rsi < 45 and macdLine < macdSignal


// ╔══════════════════════════════════════════════╗
// ║          VOLUMEN INSTITUCIONAL               ║
// ╚══════════════════════════════════════════════╝

volMA               = ta.sma(volume, 20)
institutionalVolume = volume > volMA * volMultiplier
priceImpulseUp      = close > open and close > close[1]
priceImpulseDown    = close < open and close < close[1]


// ╔═════════════════════════════════════════════════╗
// ║               FILTRO VIX                        ║
// ║  < vixBullThr → Alcista | > vixBearThr → Bajista║
// ║         Zona intermedia → NEUTRO                ║
// ╚═════════════════════════════════════════════════╝

vixBull = not na(vix) and vix < vixBullThr
vixBear = not na(vix) and vix > vixBearThr


// ╔══════════════════════════════════════════════╗
// ║                FILTRO ATR                    ║
// ╚══════════════════════════════════════════════╝

atr       = ta.atr(14)
atrMA     = ta.sma(atr, 50)
atrFilter = not useATR or atr > atrMA * 0.8


// ╔══════════════════════════════════════════════╗
// ║            FILTRO DE SESIÓN (RTH NY)         ║
// ╚══════════════════════════════════════════════╝

inSession = not useSession or not na(time(timeframe.period, "0930-1600", "America/New_York"))


// ╔══════════════════════════════════════════════╗
// ║        CONFIRMACIÓN HTF (Anti-repintado)     ║
// ╚══════════════════════════════════════════════╝

[htfFast, htfSlow] = request.security(
     syminfo.tickerid, htfTF,
     [ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen)],
     lookahead=barmerge.lookahead_off)

htfBull   = htfFast > htfSlow
htfBear   = htfFast < htfSlow
htfOkBuy  = not useHTF or htfBull
htfOkSell = not useHTF or htfBear


// ╔══════════════════════════════════════════════╗
// ║         SISTEMA DE PUNTUACIÓN (SCORING)      ║
// ╚══════════════════════════════════════════════╝

int buyers  = 0
int sellers = 0

buyers  += trendBull                                ? 25 : 0
buyers  += momentumBull                             ? 25 : 0
buyers  += institutionalVolume and priceImpulseUp   ? 25 : 0
buyers  += vixBull                                  ? 25 : 0

sellers += trendBear                                ? 25 : 0
sellers += momentumBear                             ? 25 : 0
sellers += institutionalVolume and priceImpulseDown ? 25 : 0
sellers += vixBear                                  ? 25 : 0


// ╔══════════════════════════════════════════════╗
// ║         CONTADOR DIARIO DE SEÑALES           ║
// ╚══════════════════════════════════════════════╝

var int buyCnt  = 0
var int sellCnt = 0
var int lastDay = 0

if dayofmonth != lastDay
    buyCnt  := 0
    sellCnt := 0
    lastDay := dayofmonth


// ╔═══════════════════════════════════════════════════╗
// ║   SEÑALES (barstate.isconfirmed → Sin repintar)   ║
// ╚═══════════════════════════════════════════════════╝

buyBase  = barstate.isconfirmed and buyers  >= 75 and atrFilter and inSession and htfOkBuy  and buyCnt  < maxDaily
sellBase = barstate.isconfirmed and sellers >= 75 and atrFilter and inSession and htfOkSell and sellCnt < maxDaily

fullBuy  = buyBase  and buyers  == 100
fullSell = sellBase and sellers == 100

if buyBase
    buyCnt += 1
if sellBase
    sellCnt += 1


// ╔══════════════════════════════════════════════╗
// ║            SL / TP AUTOMÁTICOS               ║
// ╚══════════════════════════════════════════════╝

slBuy  = low   - atr * slMult
tpBuy  = close + atr * tpMult
slSell = high  + atr * slMult
tpSell = close - atr * tpMult

if buyBase
    label.new(bar_index, slBuy, "SL ",
         color=color.new(color.fuchsia, 20), textcolor=color.white,
         style=label.style_label_up, size=size.small)
    label.new(bar_index, tpBuy, "TP ",
         color=color.new(color.blue, 20), textcolor=color.white,
         style=label.style_label_down, size=size.small)

if sellBase
    label.new(bar_index, slSell, "SL ",
         color=color.new(color.fuchsia, 20), textcolor=color.white,
         style=label.style_label_down, size=size.small)
    label.new(bar_index, tpSell, "TP ",
         color=color.new(color.blue, 20), textcolor=color.white,
         style=label.style_label_up, size=size.small)


// ╔══════════════════════════════════════════════╗
// ║         FLECHAS CON PUNTUACIÓN               ║
// ╚══════════════════════════════════════════════╝

plotshape(fullBuy,
     location=location.belowbar, style=shape.triangleup,
     color=color.lime, size=size.large, editable=false,
     text="COMPRA 100%", title="Compra 100%")

plotshape(buyBase and not fullBuy,
     location=location.belowbar, style=shape.triangleup,
     color=color.new(color.lime, 40), size=size.normal, editable=false,
     text="COMPRA 75%", title="Compra 75%")

plotshape(fullSell,
     location=location.abovebar, style=shape.triangledown,
     color=color.red, size=size.large, editable=false,
     text="VENTA 100%", title="Venta 100%")

plotshape(sellBase and not fullSell,
     location=location.abovebar, style=shape.triangledown,
     color=color.new(color.red, 40), size=size.normal, editable=false,
     text="VENTA 75%", title="Venta 75%")


// ╔══════════════════════════════════════════════╗
// ║            LÍNEAS EMA                        ║
// ╚══════════════════════════════════════════════╝

plot(emaFast, color=color.blue,    linewidth=2, editable=false, title="EMA 9")
plot(emaMid,  color=color.orange,  linewidth=2, editable=false, title="EMA 21", linestyle=plot.linestyle_dashed)
plot(emaSlow, color=color.fuchsia, linewidth=1, editable=false, title="EMA 50")
plot(atr,     color=color.yellow,  linewidth=1, editable=false, title="ATR")

// ╔══════════════════════════════════════════════╗
// ║            MAPA DE CALOR (HEATMAP)           ║
// ╚══════════════════════════════════════════════╝

bgcolor(inSession and buyers > sellers  ? color.new(color.green, 95) :
        inSession and sellers > buyers  ? color.new(color.red,   95) : na, editable=false)


// ╔══════════════════════════════════════════════╗
// ║         FUNCIÓN BARRA DE PUNTUACIÓN          ║
// ╚══════════════════════════════════════════════╝

scoreBar(score) =>
    filled = math.round(score / 25)
    result = ""
    for i = 1 to 4
        result := result + (i <= filled ? "█" : "░")
    result


// ╔══════════════════════════════════════════════╗
// ║           PANEL DE CONTROL (DASHBOARD)       ║
// ╚══════════════════════════════════════════════╝

var table dash = table.new(
     position.top_right, 2, 10,
     border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    // Paleta de colores
    greenDark  = color.new(color.green,  20)
    greenLight = color.new(color.green,  55)
    redDark    = color.new(color.red,    20)
    redLight   = color.new(color.red,    55)
    grayDark   = color.new(color.gray,   20)
    grayLight  = color.new(color.gray,   55)
    orange     = color.new(color.orange, 55)

    // ── Cabecera ──
    table.cell(dash, 0, 0, "INDICADOR", bgcolor=grayDark,  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "ESTADO",    bgcolor=grayDark,  text_color=color.white, text_size=size.small)

    // ── Compradores ──
    bCol = buyers >= 75 ? greenDark : greenLight
    table.cell(dash, 0, 1, "COMPRADORES", bgcolor=bCol, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, scoreBar(buyers)  + "  " + str.tostring(buyers)  + "%", bgcolor=bCol, text_color=color.white, text_size=size.small)

    // ── Vendedores ──
    sCol = sellers >= 75 ? redDark : redLight
    table.cell(dash, 0, 2, "VENDEDORES",  bgcolor=sCol, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, scoreBar(sellers) + "  " + str.tostring(sellers) + "%", bgcolor=sCol, text_color=color.white, text_size=size.small)

    // ── VIX ──
    vCol = vixBull ? greenLight : vixBear ? redLight : orange
    vLbl = vixBull ? "ALCISTA" : vixBear ? "BAJISTA" : "NEUTRO"
    table.cell(dash, 0, 3, "VIX",         bgcolor=vCol, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(math.round(nz(vix), 2)) + "  (" + vLbl + ")", bgcolor=vCol, text_color=color.white, text_size=size.small)

    // ── Smart Money ──
    smCol = institutionalVolume ? greenLight : grayLight
    table.cell(dash, 0, 4, "SMART MONEY", bgcolor=smCol, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, institutionalVolume ? "ACTIVO  ✓" : "DÉBIL", bgcolor=smCol, text_color=color.white, text_size=size.small)

    // ── Tendencia LTF ──
    trCol = trendBull ? greenLight : trendBear ? redLight : grayLight
    trLbl = trendBull ? "ALCISTA  ▲" : trendBear ? "BAJISTA  ▼" : "NEUTRO  —"
    table.cell(dash, 0, 5, "TEND. LTF",  bgcolor=trCol, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, trLbl,        bgcolor=trCol, text_color=color.white, text_size=size.small)

    // ── Tendencia HTF ──
    htfCol = htfBull ? greenLight : redLight
    htfLbl = htfBull ? "ALCISTA  ▲" : "BAJISTA  ▼"
    table.cell(dash, 0, 6, "TEND. HTF " + htfTF + "m", bgcolor=htfCol, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, htfLbl,                      bgcolor=htfCol, text_color=color.white, text_size=size.small)

    // ── Sesión ──
    sessCol = inSession ? greenLight : grayLight
    table.cell(dash, 0, 7, "SESIÓN",     bgcolor=sessCol, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, inSession ? "ACTIVA  ✓" : "CERRADA", bgcolor=sessCol, text_color=color.white, text_size=size.small)

    // ── Filtro ATR ──
    atrCol = atrFilter ? greenLight : redLight
    table.cell(dash, 0, 8, "FILTRO ATR", bgcolor=atrCol, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8, atrFilter ? "OK  ✓" : "VOL. BAJA", bgcolor=atrCol, text_color=color.white, text_size=size.small)

    // ── Límite Diario ──
    limitHit = buyCnt >= maxDaily and sellCnt >= maxDaily
    dayCol   = limitHit ? redLight : grayDark
    table.cell(dash, 0, 9, "SEÑALES/DÍA", bgcolor=dayCol, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9,
         "C: " + str.tostring(buyCnt) + "  |  V: " + str.tostring(sellCnt) + "  /  " + str.tostring(maxDaily),
         bgcolor=dayCol, text_color=color.white, text_size=size.small)


// ╔══════════════════════════════════════════════╗
// ║              ALERTAS EN ESPAÑOL              ║
// ╚══════════════════════════════════════════════╝

alertcondition(buyBase  and not fullBuy,  title="COMPRA 75%",   message="📈 NASDAQ COMPRA 75%  — {{ticker}} {{interval}}")
alertcondition(fullBuy,                   title="COMPRA 100%",  message="🚀 NASDAQ COMPRA MÁXIMA CONVICCIÓN 100% — {{ticker}} {{interval}}")
alertcondition(sellBase and not fullSell, title="VENTA 75%",    message="📉 NASDAQ VENTA 75%  — {{ticker}} {{interval}}")
alertcondition(fullSell,                  title="VENTA 100%",   message="🔴 NASDAQ VENTA MÁXIMA CONVICCIÓN 100% — {{ticker}} {{interval}}")
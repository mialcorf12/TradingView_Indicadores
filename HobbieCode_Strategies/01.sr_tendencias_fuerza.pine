//@version=6
indicator("S/R + Líneas de Tendencia por Fuerza", shorttitle = "SR·TL Fuerza", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 5000)

// ═════════════════════════ INPUTS ═════════════════════════
G1 = "Detección"
pivLen   = input.int(5, "Longitud de pivote (izq/der)", minval = 2, group = G1)
lookback = input.int(400, "Barras a analizar", minval = 50, maxval = 4500, group = G1)
atrLen   = input.int(14, "Periodo ATR", minval = 1, group = G1)

G2 = "Soportes / Resistencias"
showSR   = input.bool(true, "Mostrar S/R", group = G2)
zoneMult = input.float(0.25, "Semiancho de zona (× ATR)", minval = 0.05, step = 0.05, group = G2)
maxSR    = input.int(8, "Máx. niveles", minval = 1, maxval = 30, group = G2)
minPivSR = input.int(2, "Mín. pivotes por nivel", minval = 1, group = G2)

G3 = "Líneas de tendencia"
showTL   = input.bool(true, "Mostrar tendencias", group = G3)
tlMult   = input.float(0.15, "Tolerancia de toque (× ATR)", minval = 0.01, step = 0.05, group = G3)
maxTL    = input.int(3, "Máx. líneas por lado", minval = 1, maxval = 10, group = G3)
minTchTL = input.int(3, "Mín. toques", minval = 2, group = G3)
pivDepth = input.int(12, "Pivotes recientes a combinar", minval = 3, maxval = 30, group = G3)

G4 = "Estilo"
showLbl   = input.bool(true, "Mostrar etiquetas de fuerza", group = G4)
supWeak   = input.color(color.new(#81c784, 75), "Soporte débil", inline = "s", group = G4)
supStrong = input.color(color.new(#00c853, 0), "fuerte", inline = "s", group = G4)
resWeak   = input.color(color.new(#e57373, 75), "Resistencia débil", inline = "r", group = G4)
resStrong = input.color(color.new(#d50000, 0), "fuerte", inline = "r", group = G4)
upWeak    = input.color(color.new(#64b5f6, 75), "Tendencia alcista débil", inline = "u", group = G4)
upStrong  = input.color(color.new(#2962ff, 0), "fuerte", inline = "u", group = G4)
dnWeak    = input.color(color.new(#ffb74d, 75), "Tendencia bajista débil", inline = "d", group = G4)
dnStrong  = input.color(color.new(#ff6d00, 0), "fuerte", inline = "d", group = G4)

// ═════════════════════════ PIVOTES ═════════════════════════
atr = ta.atr(atrLen)
ph  = ta.pivothigh(high, pivLen, pivLen)
pl  = ta.pivotlow(low, pivLen, pivLen)

var phP = array.new<float>()
var phB = array.new<int>()
var plP = array.new<float>()
var plB = array.new<int>()

if not na(ph)
    phP.push(ph)
    phB.push(bar_index - pivLen)
if not na(pl)
    plP.push(pl)
    plB.push(bar_index - pivLen)

while phB.size() > 0 and phB.first() < bar_index - lookback
    phB.shift()
    phP.shift()
while plB.size() > 0 and plB.first() < bar_index - lookback
    plB.shift()
    plP.shift()

var boxes  = array.new<box>()
var lines  = array.new<line>()
var labels = array.new<label>()

// ═════════════════════════ CÁLCULO (última barra) ═════════════════════════
if barstate.islast
    while boxes.size() > 0
        boxes.pop().delete()
    while lines.size() > 0
        lines.pop().delete()
    while labels.size() > 0
        labels.pop().delete()

    // ───────── SOPORTES / RESISTENCIAS ─────────
    // Fuerza = (pivotes en la zona × 2 + rechazos) × factor de recencia
    if showSR
        tol  = atr * zoneMult
        allP = phP.copy()
        allP.concat(plP)
        allB = phB.copy()
        allB.concat(plB)
        n = allP.size()

        lvP = array.new<float>()
        lvS = array.new<float>()
        lvC = array.new<int>()
        lvR = array.new<int>()
        lvF = array.new<int>()

        if n > 0
            used = array.new<bool>(n, false)
            for i = 0 to n - 1
                if not used.get(i)
                    seed   = allP.get(i)
                    sum    = 0.0
                    cnt    = 0
                    firstB = bar_index
                    lastB  = 0
                    for j = i to n - 1
                        if not used.get(j) and math.abs(allP.get(j) - seed) <= tol * 2
                            used.set(j, true)
                            sum += allP.get(j)
                            cnt += 1
                            firstB := math.min(firstB, allB.get(j))
                            lastB  := math.max(lastB, allB.get(j))
                    if cnt >= minPivSR
                        lvl  = sum / cnt
                        zTop = lvl + tol
                        zBot = lvl - tol
                        rej  = 0
                        lim  = math.min(lookback, bar_index)
                        if lim > 0
                            for k = 0 to lim - 1
                                touched  = high[k] >= zBot and low[k] <= zTop
                                rejected = (open[k] > zTop and close[k] > zTop) or (open[k] < zBot and close[k] < zBot)
                                if touched and rejected
                                    rej += 1
                                    lastB := math.max(lastB, bar_index - k)
                        rec   = math.max(0.0, 1.0 - float(bar_index - lastB) / lookback)
                        score = (cnt * 2 + rej) * (0.6 + 0.4 * rec)
                        lvP.push(lvl)
                        lvS.push(score)
                        lvC.push(cnt)
                        lvR.push(rej)
                        lvF.push(firstB)

        m = lvS.size()
        if m > 0
            taken  = array.new<bool>(m, false)
            selIdx = array.new<int>()
            for t = 1 to math.min(maxSR, m)
                best  = -1
                bestS = -1.0
                for i = 0 to m - 1
                    if not taken.get(i) and lvS.get(i) > bestS
                        best  := i
                        bestS := lvS.get(i)
                taken.set(best, true)
                selIdx.push(best)

            maxS = lvS.get(selIdx.first())
            for idx in selIdx
                s     = lvS.get(idx) / maxS
                lvl   = lvP.get(idx)
                isSup = lvl < close
                col   = isSup ? color.from_gradient(s, 0, 1, supWeak, supStrong) : color.from_gradient(s, 0, 1, resWeak, resStrong)
                boxes.push(box.new(lvF.get(idx), lvl + tol, bar_index + 10, lvl - tol, border_color = col, border_width = s >= 0.66 ? 2 : 1, bgcolor = color.new(col, 92 - 40 * s), extend = extend.right))
                if showLbl
                    txt = (isSup ? "S " : "R ") + str.tostring(math.round(s * 100)) + "% · " + str.tostring(lvC.get(idx)) + "p/" + str.tostring(lvR.get(idx)) + "r"
                    labels.push(label.new(bar_index + 10, lvl, txt, style = label.style_label_left, color = color.new(col, 20), textcolor = color.white, size = size.small))

    // ───────── LÍNEAS DE TENDENCIA ─────────
    // Fuerza = toques × factor de recencia + longitud relativa. Se invalida si un cierre la rompe.
    if showTL
        tlTol = atr * tlMult
        cX1 = array.new<int>()
        cY1 = array.new<float>()
        cSl = array.new<float>()
        cSc = array.new<float>()
        cT  = array.new<int>()
        cUp = array.new<bool>()

        for side = 0 to 1
            isLow = side == 0
            pP = isLow ? plP : phP
            pB = isLow ? plB : phB
            m  = pP.size()
            if m >= 2
                startA = math.max(0, m - pivDepth)
                for a = startA to m - 2
                    for b = a + 1 to m - 1
                        x1      = pB.get(a)
                        y1      = pP.get(a)
                        slope   = (pP.get(b) - y1) / (pB.get(b) - x1)
                        valid   = isLow ? slope > 0 : slope < 0
                        touches = 0
                        lastT   = x1 - 1000
                        if valid
                            for off = bar_index - x1 to 0
                                bx = bar_index - off
                                lv = y1 + slope * (bx - x1)
                                broken = isLow ? close[off] < lv - tlTol : close[off] > lv + tlTol
                                if broken
                                    valid := false
                                    break
                                pr = isLow ? low[off] : high[off]
                                if math.abs(pr - lv) <= tlTol and bx - lastT > pivLen
                                    touches += 1
                                    lastT := bx
                        if valid and touches >= minTchTL
                            lenF  = float(bar_index - x1) / lookback
                            recF  = math.max(0.0, 1.0 - float(bar_index - lastT) / lookback)
                            score = touches * (0.7 + 0.3 * recF) + lenF
                            cX1.push(x1)
                            cY1.push(y1)
                            cSl.push(slope)
                            cSc.push(score)
                            cT.push(touches)
                            cUp.push(isLow)

        n2 = cSc.size()
        if n2 > 0
            taken = array.new<bool>(n2, false)
            selI  = array.new<int>()
            cntUp = 0
            cntDn = 0
            for t = 1 to n2
                best  = -1
                bestS = -1.0
                for i = 0 to n2 - 1
                    if not taken.get(i) and cSc.get(i) > bestS
                        best  := i
                        bestS := cSc.get(i)
                if best < 0
                    break
                taken.set(best, true)
                up = cUp.get(best)
                if (up and cntUp >= maxTL) or (not up and cntDn >= maxTL)
                    continue
                nowV = cY1.get(best) + cSl.get(best) * (bar_index - cX1.get(best))
                dup = false
                for j in selI
                    nowJ = cY1.get(j) + cSl.get(j) * (bar_index - cX1.get(j))
                    if cUp.get(j) == up and math.abs(nowV - nowJ) < tlTol * 3
                        dup := true
                        break
                if not dup
                    selI.push(best)
                    if up
                        cntUp += 1
                    else
                        cntDn += 1

            if selI.size() > 0
                maxS = cSc.get(selI.first())
                for i in selI
                    s    = cSc.get(i) / maxS
                    up   = cUp.get(i)
                    col  = up ? color.from_gradient(s, 0, 1, upWeak, upStrong) : color.from_gradient(s, 0, 1, dnWeak, dnStrong)
                    x1   = cX1.get(i)
                    y1   = cY1.get(i)
                    yNow = y1 + cSl.get(i) * (bar_index - x1)
                    lines.push(line.new(x1, y1, bar_index, yNow, extend = extend.right, color = col, width = 1 + math.round(s * 3), style = s < 0.33 ? line.style_dashed : line.style_solid))
                    if showLbl
                        txt = (up ? "TL↑ " : "TL↓ ") + str.tostring(math.round(s * 100)) + "% · " + str.tostring(cT.get(i)) + "t"
                        labels.push(label.new(bar_index, yNow, txt, style = up ? label.style_label_upper_left : label.style_label_lower_left, color = color.new(col, 20), textcolor = color.white, size = size.small))
